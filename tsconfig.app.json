{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": false,
    "noEmit": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "src/skyrim/**/*.ts",
    "src/skyrim/**/*.tsx",
    "src/main.tsx",
    "src/App.tsx",
    "src/vite-env.d.ts",
    "src/animations.ts",
    "src/backup.ts",
    "src/dates.ts",
    "src/db.ts",
    "src/game-core.ts",
    "src/game-engine.ts",
    "src/gas-proxy.ts",
    "src/sync-manager.ts",
    "src/data-layer.ts"
  ],
  "exclude": [
    "src/sw.ts",
    "dist",
    "node_modules",
    "build"
  ]
}
