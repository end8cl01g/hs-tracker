#!/usr/bin/env bash
# .githooks/pre-commit — commit 前把三道閘跑完，避免推上去才發現.sw 版本沒換/測試紅燈
# 啟用：npm run hooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
node scripts/build.mjs >/dev/null
node scripts/check.mjs >/dev/null
node --test tests/ >/dev/null
git add js/build-info.js 2>/dev/null || true
echo "✓ pre-commit：build + check + 63 測試全綠"
