#!/usr/bin/env bash
# .githooks/post-checkout — 換分支後依賴可能變；裝完顺手 build，别让 dist/ 留在舊 state
# 只在 lock 檔有變化時才裝（否則每次 checkout 都跑 npm ci 很煩）
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
prev="$(git rev-parse HEAD^{} 2>/dev/null || echo '')"
[ -n "$prev" ] || exit 0
if git diff --name-only "$prev" HEAD 2>/dev/null | grep -q '^package-lock.json$'; then
  npm ci --silent
  node scripts/build.mjs
  echo "✓ post-checkout：依賴已重裝、dist 已重建"
fi
exit 0
